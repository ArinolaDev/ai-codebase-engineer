# Copy this file to backend/.env (same folder as requirements.txt). Every setting is optional.
# Never commit the real .env file: it is already in .gitignore.

# Lets the app open pull requests with fixes you approved.
# Create a fine-grained token limited to ONE repository, with Contents and Pull requests set to Read and write:
#   https://github.com/settings/personal-access-tokens/new
# Paste it after the = with no quotes and no spaces.
GITHUB_TOKEN=

# Where projects and the search index are stored (the defaults are fine).
# DATA_DIR=./data/repos
# CHROMA_PERSIST_DIR=./data/indexes
