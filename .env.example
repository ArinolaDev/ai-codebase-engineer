# --- Anthropic API ---
ANTHROPIC_API_KEY=your_api_key_here

# --- Database ---
# Local Postgres via docker-compose. Adjust if you're using something else.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codebase_engineer

# --- Vector store (Chroma) ---
CHROMA_PERSIST_DIR=./data/indexes

# --- App ---
APP_ENV=development
DATA_DIR=./data/repos

# --- CORS (comma-separated origins allowed to hit the API) ---
ALLOWED_ORIGINS=http://localhost:5173
