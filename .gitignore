# Python
venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# Env / secrets
.env
*.env.local

# Node
node_modules/
frontend/dist/
frontend/.vite/

# Data (never commit user-uploaded/cloned repos or generated indexes)
# NOTE: patterns containing a slash are anchored to the repo root, so the
# backend/ versions are required — our data folders live inside backend/.
data/repos/*
!data/repos/.gitkeep
data/indexes/*
!data/indexes/.gitkeep
backend/data/repos/*
!backend/data/repos/.gitkeep
backend/data/indexes/*
!backend/data/indexes/.gitkeep

# Local test artifacts
*.zip

# DB
*.sqlite3

# OS/editor
.DS_Store
.vscode/
*.log
backend/data/history/
